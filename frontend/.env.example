# URL of the FastAPI backend, used server-side by next.config.ts to build the
# rewrite target. The browser calls this Next.js app, then Next proxies /api/*
# and /health to API_URL.
API_URL=https://ca-smp-backend-dev.victoriousglacier-6c7c6909.centralus.azurecontainerapps.io

# Serves mock data via MSW instead of calling the backend at all. Must be
# false in any real environment.
NEXT_PUBLIC_ENABLE_MOCKS=false

# Visible app name (prepared for i18n).
NEXT_PUBLIC_APP_NAME=Secure Multicloud Platform

# --- Do not add Azure, AWS, or PostgreSQL credentials here. ---
# Any NEXT_PUBLIC_* variable is exposed to the browser.
# Cloud/DB secrets live exclusively in the backend.
