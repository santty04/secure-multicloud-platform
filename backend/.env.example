APP_NAME=Secure Multicloud Platform API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false

# CORS
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# ============================================================
# DATABASE - LOCAL DEVELOPMENT
# ============================================================

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DATABASE
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DATABASE_test

# ============================================================
# DATABASE - AZURE POSTGRESQL
# ============================================================

DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=secure_multicloud
DATABASE_USER=id-smp-backend-dev
DATABASE_APPLICATION_USER=id-smp-backend-dev
DATABASE_APPLICATION_PRINCIPAL_ID=

# ============================================================
# APPLICATION AUTHENTICATION
# ============================================================

SECRET_KEY=replace-with-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256

# ============================================================
# AZURE
# ============================================================

AZURE_SUBSCRIPTION_ID=AZURE_SUBSCRIPTION_ID
AZURE_WRITE_ENABLED=false

AZURE_VIEWER_CLIENT_ID=AZURE_VIEWER_MANAGED_IDENTITY_CLIENT_ID
AZURE_OPERATOR_CLIENT_ID=AZURE_OPERATOR_MANAGED_IDENTITY_CLIENT_ID
AZURE_ADMINISTRATOR_CLIENT_ID=AZURE_ADMINISTRATOR_MANAGED_IDENTITY_CLIENT_ID
AZURE_RESOURCE_GROUP=AZURE_RESOURCE_GROUP
AZURE_MANAGED_SUBNET_ID=AZURE_MANAGED_SUBNET_ID
AZURE_DEFAULT_VM_SIZE=Standard_B2pts_v2
AZURE_DEFAULT_LOCATION=centralus

# ============================================================
# AWS
# ============================================================

AWS_REGION=us-east-2
AWS_WRITE_ENABLED=false

AWS_BACKEND_EXECUTION_ROLE_ARN=arn:aws:iam::AWS_ACCOUNT_ID:role/SMPBackendExecutionRole

AWS_VIEWER_ROLE_ARN=arn:aws:iam::AWS_ACCOUNT_ID:role/SMPViewerRole
AWS_OPERATOR_ROLE_ARN=arn:aws:iam::AWS_ACCOUNT_ID:role/SMPOperatorRole
AWS_ADMINISTRATOR_ROLE_ARN=arn:aws:iam::AWS_ACCOUNT_ID:role/SMPAdministratorRole

AWS_AMI_ID=
AWS_SUBNET_ID=
AWS_SECURITY_GROUP_ID=
AWS_INSTANCE_TYPE=t3.micro
AWS_ROOT_VOLUME_SIZE_GB=8

# ============================================================
# AWS WORKLOAD IDENTITY FEDERATION FROM AZURE
# ============================================================

AWS_FEDERATION_AUDIENCE=
AZURE_MANAGED_IDENTITY_CLIENT_ID=

